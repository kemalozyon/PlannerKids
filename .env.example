# Bu dosyayı .env olarak kopyala ve Supabase → Project Settings → API'den doldur.
# İkisi de boş bırakılırsa uygulama demo modunda (localStorage) açılır.
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# İsteğe bağlı — yalnızca `npm run report:preview` için (VITE_ öneki olmadığı için tarayıcıya gitmez).
# Canlıda bunlar `supabase secrets set` ile Edge Function'a verilir.
EVREN_API_KEY=
# REPORT_MODEL=deepseek-v4-flash
RESEND_API_KEY=
REPORT_FROM="Çalışma Takip <rapor@alanadin.com>"
