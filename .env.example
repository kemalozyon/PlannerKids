# Bu dosyayı .env olarak kopyala ve Supabase → Project Settings → API'den doldur.
# İkisi de boş bırakılırsa uygulama demo modunda (localStorage) açılır.
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# İsteğe bağlı — yalnızca `npm run report:preview` için (VITE_ öneki olmadığı için tarayıcıya gitmez).
# Canlıda bunlar `supabase secrets set` ile Edge Function'a verilir.
# Raporun metnini Gemini yazar (demo sesleriyle aynı anahtar, aşağıda GEMINI_API_KEY).
# REPORT_MODEL=gemini-3.8-flash
RESEND_API_KEY=
REPORT_FROM="Çalışma Takip <rapor@alanadin.com>"

# İsteğe bağlı — yalnızca `npm run demo:audio` için (tanıtım turunun seslerini Gemini TTS ile src/demo/audio/ altına üretir,
# ffmpeg gerekir). VITE_ öneki olmadığı için tarayıcıya gitmez. Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_VOICE=Sulafat
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_CHECK_MODEL=gemini-3.8-flash
